  "files": [
    "build/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsx src/build/index.ts",
    "types": "json2ts data/schema/dev-test.json src/types/dev-test.ts && json2ts data/schema/dev-feature.json src/types/dev-feature.ts && json2ts data/schema/test.json src/types/test.ts && cd data/schema && json2ts feature.json ../../src/types/feature.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm install && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.1",
